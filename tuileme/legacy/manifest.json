{
  "manifest_version": 3,
  "name": "X 智能回帖",
  "version": "0.1.0",
  "description": "在 X/Twitter 回复按钮旁添加 AI 智能回帖，支持多人格、可自定义按钮名、OpenAI Base URL。",
  "permissions": ["storage"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}
